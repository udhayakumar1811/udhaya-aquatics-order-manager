rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and firebase.json - see DEPLOY_RULES.md)
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders contain customer PII (name, phone, address). Only a signed-in
    // user may read or write them. This app has no public sign-up, so in
    // practice that means only accounts you create yourself in the
    // Firebase Console (Authentication -> Users -> Add user).
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Used to atomically hand out sequential order IDs (e.g. ADQ001).
    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // Product / combo catalog (pricing reference).
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
